{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pivot/investigation.schema.json",
  "title": "Investigation (outbound): the case record, its budget, and a replayable step log",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "question", "seeds", "goals", "budget", "mode", "synapse_view", "status", "steps", "assessments", "created_at"],
  "properties": {
    "schema": {"const": "pivot.investigation/1"},
    "id": {"type": "string"},
    "question": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "analyst": {"type": "string"},
    "seeds": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/nodeKey"}},
    "window": {"$ref": "common.schema.json#/$defs/window"},
    "goals": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["kind"],
        "properties": {
          "kind": {"enum": ["reach_tag", "reach_form", "corroborate", "storm"]},
          "tag": {"$ref": "common.schema.json#/$defs/tag"},
          "form": {"$ref": "common.schema.json#/$defs/form"},
          "min_independent_groups": {"type": "integer", "minimum": 1},
          "storm": {"type": "string", "description": "Arbitrary goal predicate, evaluated inside the investigation view."}
        }
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false, "required": ["max_hops", "max_queries", "max_seconds"],
      "properties": {
        "max_hops": {"type": "integer", "minimum": 1, "maximum": 10},
        "max_queries": {"type": "integer", "minimum": 1},
        "max_seconds": {"type": "integer", "minimum": 1},
        "max_nodes": {"type": "integer", "minimum": 1}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "allow_external_egress": {"type": "boolean", "default": false},
        "allow_active": {"type": "boolean", "default": false},
        "prevalence_ceiling": {"type": "integer", "minimum": 1},
        "allowlists": {"type": "array", "items": {"type": "string"}}
      }
    },
    "mode": {"enum": ["manual", "assisted", "auto"]},
    "synapse_view": {"type": "string", "description": "Iden of the forked view holding this investigation's graph."},
    "case_links": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["system", "id"],
                "properties": {"system": {"enum": ["iris", "thehive", "other"]}, "id": {"type": "string"}, "url": {"type": "string"}}}
    },
    "status": {"enum": ["open", "goal_met", "exhausted", "budget_spent", "closed", "abandoned"]},
    "steps": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["n", "at", "connector", "method", "inputs", "batch_fingerprint", "results", "pruned", "duration_ms", "decided_by"],
        "properties": {
          "n": {"type": "integer", "minimum": 0},
          "at": {"type": "string", "format": "date-time"},
          "connector": {"type": "string"},
          "method": {"type": "string"},
          "inputs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/nodeKey"}},
          "batch_fingerprint": {"type": "string"},
          "results": {"type": "integer", "minimum": 0},
          "truncated": {"type": "boolean"},
          "pruned": {"type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["node", "reason"],
            "properties": {"node": {"$ref": "common.schema.json#/$defs/nodeKey"},
                           "reason": {"enum": ["prevalence", "allowlist", "benign_infra", "budget", "policy_egress", "policy_active"]}}}},
          "duration_ms": {"type": "integer", "minimum": 0},
          "decided_by": {"enum": ["analyst", "planner", "llm_ranker"]},
          "error": {"type": "string"}
        }
      }
    },
    "assessments": {"type": "array", "items": {"type": "string"}, "description": "Assessment ids."},
    "plan_revisions": {
      "description": "Every route-plan revision (pivot.plan/1), one per step or batch of steps. The latest is the current plan.",
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["revision", "at", "trigger", "ref"],
        "properties": {
          "revision": {"type": "integer", "minimum": 0},
          "at": {"type": "string", "format": "date-time"},
          "trigger": {"type": "string"},
          "ref": {"type": "string", "description": "Where the full plan document is stored."},
          "by_status": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
          "best_route": {"type": ["string", "null"]}
        }
      }
    }
  }
}
